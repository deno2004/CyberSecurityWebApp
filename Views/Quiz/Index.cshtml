@model IEnumerable<CyberSecurityWebApp.Models.Quiz>
@{
    ViewData["Title"] = "Kvizi";
}
<br />
<div class="page-header">
    <h1>✅ Kvizi</h1>
    <p>Preizkusite svoje znanje o kibernetski varnosti</p>
</div>

<div class="quiz-modules">
    @foreach (var module in Model)
    {
        <div class="quiz-module-card">
            <div class="module-icon">
                <img src="@module.IconClass" alt="Quiz icon" />
            </div>
            <div class="module-content">
                <h3>@module.Title</h3>
                <p>@module.Description</p>
                <div class="module-meta">
                    <span class="content-category">📝 5 vprašanj</span> 
                </div>
                <div class="module-actions">
                    <a href="/Quiz/Start/@module.QuizId" class="btn btn-primary">Začni kviz</a>
                    <a href="/Quiz/Share/@module.QuizId" class="btn btn-secondary">📤 Deli</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="quiz-info">
    <h3>ℹ️ Kako delujejo kvizi?</h3>
    <div class="info-steps">
        <div class="step">
            <div class="step-number">1</div>
            <h4>Izberite kviz</h4>
            <p>Kliknite na "Začni kviz" pri želeni temi</p>
        </div>
        <div class="step">
            <div class="step-number">2</div>
            <h4>Odgovorite na vprašanja</h4>
            <p>Izberite pravilen odgovor za vsako vprašanje</p>
        </div>
        <div class="step">
            <div class="step-number">3</div>
            <h4>Preglejte rezultate</h4>
            <p>Prejmite povratno informacijo in razlage</p>
        </div>
    </div>
</div>

<div class="share-info">
    <div class="share-icon">🔗</div>
    <div class="share-content">
        <h3>Delite kviz z drugimi</h3>
        <p>
            Kliknite na gumb "Deli" pri kateremkoli kvizu, da ustvarite unikatno povezavo.
            To povezavo lahko delite s prijatelji, sodelavci ali družino, da tudi oni lahko
            preizkusijo svoje znanje o kibernetski varnosti.
        </p>
    </div>
</div>

