@model Quiz
@{
    ViewData["Title"] = "Kviz - " + Model.Title;

    var currentQuestionIndex = ViewBag.CurrentQuestion as int? ?? 1;

    var questions = Model.Questions
        .OrderBy(q => q.QuestionId)
        .ToList();

    var currentQuestion = questions
        .Skip(currentQuestionIndex - 1)
        .FirstOrDefault();
}

<div class="quiz-container">

    <div class="quiz-header">
        <h2>@Model.Title</h2>

        <div class="quiz-progress">
            Vprašanje @currentQuestionIndex od @questions.Count
        </div>
    </div>

    @if (currentQuestion != null)
    {
        <div class="question-card">

            <h3>@currentQuestion.Text</h3>

            <form asp-action="SubmitAnswer" method="post">

                <input type="hidden" name="quizId" value="@Model.QuizId" />
                <input type="hidden" name="questionId" value="@currentQuestion.QuestionId" />
                <input type="hidden" name="questionIndex" value="@currentQuestionIndex" />

                <div class="answers-list">
                    @foreach (var answer in currentQuestion.Answers)
                    {
                        <label class="answer-option">
                            <input type="radio"
                                   name="answerId"
                                   value="@answer.AnswerId"
                                   required />

                            <span class="answer-text">@answer.Text</span>
                            <span class="checkmark"></span>
                        </label>
                    }
                </div>

                <div class="question-actions">
                    <button type="submit" class="btn btn-primary">
                        @if (currentQuestionIndex < questions.Count)
                        {
                            <text>Naslednje vprašanje →</text>
                        }
                        else
                        {
                            <text>Zaključi kviz ✓</text>
                        }
                    </button>
                </div>

            </form>
        </div>
    }
</div>

<style>
    .answer-option {
        display: block;
        position: relative;
        padding: 15px 20px 15px 50px;
        margin-bottom: 12px;
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .answer-option:hover {
            border-color: #2196F3;
            background: #f5f9ff;
        }

        .answer-option input[type="radio"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

    .checkmark {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
        height: 20px;
        width: 20px;
        background-color: #fff;
        border: 2px solid #ccc;
        border-radius: 50%;
    }

    .answer-option:hover .checkmark {
        border-color: #2196F3;
    }

    .answer-option input[type="radio"]:checked ~ .checkmark {
        background-color: #2196F3;
        border-color: #2196F3;
    }

        .answer-option input[type="radio"]:checked ~ .checkmark:after {
            content: "";
            position: absolute;
            display: block;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: white;
        }

    .answer-option input[type="radio"]:checked {
        & ~ .answer-text

    {
        font-weight: 600;
        color: #1976D2;
    }

    }
</style>