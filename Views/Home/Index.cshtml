@{
    ViewData["Title"] = "Domov";
}
<br />
<div class="hero">
    <div class="hero-content">
        <h1>🛡️ Dobrodošli v Cyber Security Akademiji</h1>
        <p class="hero-subtitle">Naučite se osnov kibernetske varnosti in zaščitite se v digitalnem svetu</p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="hero-buttons">
                <a href="/Home/Learn" class="btn btn-primary">Začni z učenjem</a>
                <a href="/Quiz" class="btn btn-secondary">Preizkusi svoje znanje</a>
            </div>
        }
    </div>
</div>

<div class="features">
    <div class="feature-card">
        <div class="feature-icon">📚</div>
        <h3>Izobraževalne vsebine</h3>
        <p>Osnove kibernetske varnosti razložene na preprost in razumljiv način</p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Home/Learn" class="btn btn-link">Preberi več →</a>
        }
    </div>

    <div class="feature-card">
        <div class="feature-icon">✅</div>
        <h3>Interaktivni kvizi</h3>
        <p>Preverite in utrdite svoje znanje z našimi kvizi</p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Quiz" class="btn btn-link">Reši kviz →</a>
        }
    </div>

    <div class="feature-card">
        <div class="feature-icon">🔗</div>
        <h3>Deljenje povezav</h3>
        <p>Ustvarite povezavo in delite kviz z drugimi uporabniki</p>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Quiz" class="btn btn-link">Ustvari povezavo →</a>
        }
    </div>
</div>

<div class="info-section">
    <h2>Zakaj je kibernetska varnost pomembna?</h2>
    <div class="info-grid">
        <div class="info-item">
            <span class="info-number">🔐</span>
            <h4>Zaščita osebnih podatkov</h4>
            <p>Vaši osebni podatki so dragoceni. Naučite se, kako jih zaščititi.</p>
        </div>
        <div class="info-item">
            <span class="info-number">💰</span>
            <h4>Finančna varnost</h4>
            <p>Preprečite goljufije in zaščitite svoje finančne račune.</p>
        </div>
        <div class="info-item">
            <span class="info-number">🌐</span>
            <h4>Varna uporaba interneta</h4>
            <p>Varno se gibljite po internetu in družbenih omrežjih.</p>
        </div>
        <div class="info-item">
            <span class="info-number">👨‍👩‍👧‍👦</span>
            <h4>Zaščita družine</h4>
            <p>Zaščitite sebe in svoje bližnje pred spletnimi grožnjami.</p>
        </div>
    </div>
</div>

<div class="cta-section">
    <h2>Pripravljeni začeti?</h2>
    <p>Začnite svojo pot do boljšega razumevanja kibernetske varnosti še danes!</p>
    <br />
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a href="/Home/Learn" class="btn btn-large btn-primary">Začni zdaj</a>
    }
</div>
