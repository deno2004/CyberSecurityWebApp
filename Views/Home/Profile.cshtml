@model User

@{
    ViewData["Title"] = "Moj profil";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">👤</div>
        <h1>Moj profil</h1>
        <p>Uredi svoje osebne podatke</p>
    </div>

    <div class="form-card">
        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Ime</label>
                <input asp-for="FirstName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Priimek</label>
                <input asp-for="LastName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Uporabniško ime</label>
                <input asp-for="Username" class="form-input" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-input" />
            </div>

            <div class="form-group">
                <label>Novo geslo (pusti prazno, če ne želiš spremeniti)</label>
                <input asp-for="Password" type="password" class="form-input" />
            </div>

            <div class="form-group">
                <label>Vloga</label>
                @if (User.IsInRole("Admin"))
                {
                    <div class="badge badge-admin">👑 Administrator</div>
                }
                else
                {
                    <div class="badge badge-user">👤 Uporabnik</div>
                }
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Shrani spremembe
                </button>
            </div>
        </form>
    </div>
</div>