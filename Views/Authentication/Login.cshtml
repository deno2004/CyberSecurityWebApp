@model User
@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">🔐</div>
            <h1>Prijava</h1>
            <p>Dobrodošli nazaj v Cyber Security Akademiji</p>
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" asp-for="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Vnesite elektronski naslov" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Vnesite geslo" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-large">Prijavi se</button>
        </form>

        <div class="auth-footer">
            <p>Nimate računa? <a asp-action="Register">Registrirajte se</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

