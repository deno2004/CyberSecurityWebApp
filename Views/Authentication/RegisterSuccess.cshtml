@{
    ViewData["Title"] = "Registracija uspešna";
    var email = ViewBag.Email as string ?? "vaš e-poštni naslov";
}

<div class="regsuccess-wrap">
    <div class="regsuccess-card">

        <div class="regsuccess-envelope">
            <div class="envelope-body">📧</div>
        </div>

        <h1 class="regsuccess-title">Preverite nabiralnik!</h1>

        <p class="regsuccess-msg">
            Registracija je bila uspešna. Poslali smo potrditveni e-mail na:
        </p>

        <div class="regsuccess-email-box">
            <i class="bi bi-envelope-fill"></i>
            <strong>@email</strong>
        </div>

        <p class="regsuccess-sub">
            Kliknite na potrditveno povezavo v e-mailu, da aktivirate vaš račun.
            Povezava velja <strong>24 ur</strong>.
        </p>

        <div class="regsuccess-steps">
            <div class="rs-step">
                <span class="rs-step-num">1</span>
                <span>Odprite vaš e-poštni nabiralnik</span>
            </div>
            <div class="rs-step">
                <span class="rs-step-num">2</span>
                <span>Poiščite sporočilo od <em>Cyber Security Akademija</em></span>
            </div>
            <div class="rs-step">
                <span class="rs-step-num">3</span>
                <span>Kliknite "Potrdi e-poštni naslov"</span>
            </div>
        </div>

        <div class="regsuccess-note">
            <i class="bi bi-info-circle"></i>
            Če e-maila ne najdete, preverite <strong>mapo Neželena pošta (Spam)</strong>.
        </div>

        <div class="regsuccess-actions">
            <a asp-action="Login" class="btn-rs-primary">
                <i class="bi bi-box-arrow-in-right"></i> Pojdi na prijavo
            </a>
        </div>

    </div>
</div>

<style>
    .regsuccess-wrap {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .regsuccess-card {
        background: #fff;
        border: 1.5px solid #f0f0f0;
        border-radius: 20px;
        padding: 48px 40px;
        max-width: 480px;
        width: 100%;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.07);
    }

    .regsuccess-envelope {
        font-size: 3.5rem;
        margin-bottom: 20px;
        animation: float 2.5s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    .regsuccess-title {
        font-size: 1.55rem;
        font-weight: 800;
        color: #1a1a1a;
        margin: 0 0 12px;
        letter-spacing: -0.02em;
    }

    .regsuccess-msg {
        font-size: 0.93rem;
        color: #666;
        margin: 0 0 14px;
        line-height: 1.55;
    }

    .regsuccess-email-box {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #eff6ff;
        border: 1.5px solid #bfdbfe;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 0.92rem;
        color: #1d4ed8;
        margin-bottom: 18px;
    }

    .regsuccess-sub {
        font-size: 0.87rem;
        color: #888;
        line-height: 1.6;
        margin: 0 0 24px;
    }

    .regsuccess-steps {
        display: flex;
        flex-direction: column;
        gap: 10px;
        text-align: left;
        background: #f9fafb;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 18px;
    }

    .rs-step {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.87rem;
        color: #555;
    }

    .rs-step-num {
        width: 26px;
        height: 26px;
        background: #2563eb;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 800;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .regsuccess-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #fffbeb;
        border: 1.5px solid #fde68a;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.84rem;
        color: #92400e;
        text-align: left;
        margin-bottom: 24px;
    }

        .regsuccess-note i {
            flex-shrink: 0;
            margin-top: 1px;
        }

    .btn-rs-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #2563eb;
        color: #fff;
        font-weight: 700;
        font-size: 0.92rem;
        padding: 12px 28px;
        border-radius: 10px;
        text-decoration: none;
        transition: background 0.18s, transform 0.15s;
        box-shadow: 0 3px 12px rgba(37,99,235,0.28);
    }

        .btn-rs-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            color: #fff;
        }

    body.dark-mode .regsuccess-card {
        background: #1e1e1e;
        border-color: #2b2b2b;
        box-shadow: none;
    }

    body.dark-mode .regsuccess-title {
        color: #e4e4e4;
    }

    body.dark-mode .regsuccess-msg,
    body.dark-mode .regsuccess-sub {
        color: #aaa;
    }

    body.dark-mode .regsuccess-steps {
        background: #252525;
        border-color: #333;
    }

    body.dark-mode .rs-step {
        color: #bbb;
    }

    body.dark-mode .regsuccess-email-box {
        background: #1a2235;
        border-color: #1d3a6e;
        color: #60a5fa;
    }

    body.dark-mode .regsuccess-note {
        background: #2a1f0a;
        border-color: #5c3d0a;
        color: #fbbf24;
    }
</style>

