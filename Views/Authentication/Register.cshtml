@model User
@{
    ViewData["Title"] = "Registracija";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">👤</div>
            <h1>Registracija</h1>
            <p>Ustvarite račun v Cyber Security Akademiji</p>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label>Ime</label>
                <input asp-for="FirstName" class="form-control" placeholder="Janez" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Priimek</label>
                <input asp-for="LastName" class="form-control" placeholder="Novak" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Uporabniško ime</label>
                <input asp-for="Username" class="form-control" placeholder="janez.novak" />
                <span asp-validation-for="Username" class="text-danger"></span>
                <small>Uporabniško ime mora biti dolgo med 3 in 50 znaki</small>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="janez.novak@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Geslo</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <small>Vsaj 6 znakov, vsebovati mora veliko in malo črko ter številko</small>
            </div>

            <div class="password-requirements">
                <h4>📋 Zahteve za geslo:</h4>
                <ul>
                    <li>Vsaj 6 znakov</li>
                    <li>Vsaj ena velika črka (A-Z)</li>
                    <li>Vsaj ena mala črka (a-z)</li>
                    <li>Vsaj ena številka (0-9)</li>
                </ul>
            </div>

            <button type="submit" class="btn btn-primary btn-large">Registriraj se</button>
        </form>

        <div class="auth-footer">
            <p>Že imate račun? <a asp-action="Login">Prijavite se</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
