<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cyber Security Akademija</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" href="/">🛡️ Cyber Security Akademija</a>
                <ul class="nav-menu">
                    <li>
                        <button id="themeToggle" class="theme-toggle">
                            ☀️
                        </button>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        // 🔐 ADMIN NAVBAR
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-dropdown">
                                <button class="nav-user-button" id="userDropdownBtn">
                                    👤 @User.Identity.Name ▾
                                </button>

                                <div class="dropdown-menu" id="userDropdownMenu">
                                    <form asp-controller="Authentication"
                                          asp-action="Logout"
                                          method="post">
                                        <button type="submit" class="dropdown-logout">
                                            Odjava
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                        // 👤 NORMAL USER NAVBAR
                        else
                        {
                            <li><a asp-controller="Home" asp-action="About">O nas</a></li>
                            <li><a asp-controller="Course" asp-action="Index">Tečaji</a></li>
                            <li><a href="/Quiz">Kvizi</a></li>

                            <li class="nav-dropdown">
                                <button class="nav-user-button" id="userDropdownBtn">
                                    👤 @User.Identity.Name ▾
                                </button>

                                <div class="dropdown-menu" id="userDropdownMenu">
                                    <a href="/Home/Profile">Moj profil</a>

                                    <form asp-controller="Authentication"
                                          asp-action="Logout"
                                          method="post">
                                        <button type="submit" class="dropdown-logout">
                                            Odjava
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        // 🚫 NOT LOGGED IN
                        <li><a href="/Authentication/Login">Prijava</a></li>
                        <li><a href="/Authentication/Register">Registracija</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }
        @RenderBody()
    </main>

    <footer class="main-footer">
    <div class="container footer-grid">

        <div class="footer-brand">
            <h3>🛡️ Cyber Security Akademija</h3>
            <p>Platforma za izobraževanje o kibernetski varnosti.</p>
        </div>

        <div class="footer-links">
            <h4>Navigacija</h4>
            <a href="/Course">Tečaji</a>
            <a href="/Quiz">Kvizi</a>
            <a href="/Home/Profile">Profil</a>
        </div>

        <div class="footer-links">
            <h4>Pomoč</h4>
            <a href="#">Podpora</a>
            <a href="#">Pogoji uporabe</a>
            <a href="#">Zasebnost</a>
        </div>

        <div class="footer-copy">
            <p>&copy; 2026 Cyber Security Akademija</p>
        </div>

    </div>
</footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.addEventListener('load', () => {
            document.querySelector('.nav-menu')?.classList.add('loaded');
        });
    </script>
    <script>
        const dropdownBtn = document.getElementById('userDropdownBtn');
        const dropdownMenu = document.getElementById('userDropdownMenu');

        dropdownBtn?.addEventListener('click', function (e) {
            e.stopPropagation();
            dropdownMenu.classList.toggle('show');
        });

        document.addEventListener('click', function () {
            dropdownMenu?.classList.remove('show');
        });
    </script>
    <script>
        const themeToggle = document.getElementById("themeToggle");

        // Load saved theme
        if (localStorage.getItem("theme") === "dark") {
            document.body.classList.add("dark-mode");
            themeToggle.textContent = "🌙";
        }

        themeToggle?.addEventListener("click", () => {
            document.body.classList.toggle("dark-mode");

            if (document.body.classList.contains("dark-mode")) {
                localStorage.setItem("theme", "dark");
                themeToggle.textContent = "🌙";
            } else {
                localStorage.setItem("theme", "light");
                themeToggle.textContent = "☀️";
            }
        });
    </script>
</body>
</html>

<style>

    /* ===== FOOTER ===== */
    .main-footer {
        margin-top: 50px;
        padding: 40px 0;
        background: #111;
        color: #ccc;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 30px;
    }

    .footer-brand h3 {
        margin-bottom: 10px;
        color: #fff;
    }

    .footer-links h4 {
        margin-bottom: 10px;
        color: #fff;
    }

    .footer-links a {
        display: block;
        text-decoration: none;
        color: #aaa;
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

        .footer-links a:hover {
            color: #fff;
        }

    .footer-copy {
        grid-column: 1 / -1;
        text-align: center;
        font-size: 0.8rem;
        color: #777;
        margin-top: 20px;
    }

    /* ===== DARK MODE ===== */
    body.dark-mode .main-header {
        background: rgba(20,20,20,0.9);
        border-color: #333;
    }

    body.dark-mode .navbar-brand {
        color: #eee;
    }

    body.dark-mode .nav-menu a {
        color: #bbb;
    }

    body.dark-mode .dropdown-menu {
        background: #1e1e1e;
        border-color: #333;
    }

    body.dark-mode .main-footer {
        background: #0a0a0a;
    }
</style>
