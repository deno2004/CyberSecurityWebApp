@model IEnumerable<User>

@{
    ViewData["Title"] = "Upravljanje uporabnikov";
}

<div class="users-container">
    <div class="users-header">
        <div class="users-icon">👥</div>
        <h1>Upravljanje uporabnikov</h1>
        <p>Pregled vseh registriranih računov v sistemu</p>
        <div class="users-top-actions">
            <a asp-action="AddUser" class="btn btn-secondary btn-add">
                ➕ Dodaj uporabnika
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary btn-add">
                Nazaj
            </a>
        </div>
    </div>

    <div class="users-grid">
        @foreach (var user in Model)
        {
            <div class="user-card">
                <div class="user-card-header">
                    <div class="user-avatar">
                        @(user.FirstName.Substring(0, 1))@(user.LastName.Substring(0, 1))
                    </div>
                    <div>
                        <h3>@user.FirstName @user.LastName</h3>
                        <p class="username">@user.Username</p>
                    </div>
                </div>

                <div class="user-info">
                    <div class="info-row">
                        <span>Email:</span>
                        <span>@user.Email</span>
                    </div>

                    <div class="info-row">
                        <span>Vloga:</span>
                        @if (user.IsAdmin)
                        {
                            <span class="badge badge-admin">👑 Administrator</span>
                        }
                        else
                        {
                            <span class="badge badge-user">👤 Uporabnik</span>
                        }
                    </div>
                </div>

                <div class="user-actions">
                    <a asp-action="EditUser"
                       asp-route-id="@user.UserId"
                       class="btn btn-secondary btn-sm">
                        ✏️ Uredi
                    </a>

                    <form asp-action="DeleteUser"
                          asp-route-id="@user.UserId"
                          method="post">
                        <button type="submit"
                                class="btn btn-secondary btn-sm">
                            Izbriši
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
