@model User

@{
    ViewData["Title"] = "Uredi uporabnika";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">✏️</div>
        <h1>Uredi uporabnika</h1>
        <p>Posodobi podatke uporabniškega računa</p>
    </div>

    <div class="form-card">
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="UserId" />

            <div class="form-group">
                <label>Ime</label>
                <input asp-for="FirstName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Priimek</label>
                <input asp-for="LastName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Uporabniško ime</label>
                <input asp-for="Username" class="form-input" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-input" />
            </div>

            <div class="form-group">
                <label>Novo geslo (pusti prazno, če ne želiš spremeniti)</label>
                <input asp-for="Password" type="password" class="form-input" />
            </div>

            <div class="form-group checkbox-group">
                <input asp-for="IsAdmin" type="checkbox" />
                <label>Administrator</label>
            </div>

            <div class="form-actions">
                <a asp-action="Users" class="btn btn-secondary">
                    Nazaj
                </a>

                <button type="submit" class="btn btn-primary">
                    Shrani spremembe
                </button>
            </div>
        </form>
    </div>
</div>