@model IEnumerable<Quiz>

@{
    ViewData["Title"] = "Upravljanje kvizov";
}

<div class="users-container">
    <div class="users-header">
        <div class="users-icon">🧠</div>
        <h1>Upravljanje kvizov</h1>
        <p>Pregled vseh kvizov v sistemu</p>

        <div class="users-top-actions">
            <a asp-action="AddQuiz" class="btn btn-secondary btn-add">
                ➕ Dodaj kviz
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary btn-add">
                Nazaj
            </a>
        </div>
    </div>

    <div class="users-grid">
        @foreach (var quiz in Model)
        {
            <div class="user-card">
                <div class="user-card-header">
                    <div>
                        <h3>@quiz.Title</h3>
                        <p class="username">@quiz.Description</p>
                    </div>
                </div>

                <div class="user-info">
                    <div class="info-row">
                        <span>Vprašanj:</span>
                        <span>@(quiz.Questions?.Count ?? 0)</span>
                    </div>
                </div>

                <div class="user-actions">
                    <a asp-action="Questions"
                       asp-route-id="@quiz.QuizId"
                       class="btn btn-secondary btn-add">
                        Vprašanja
                    </a>

                    <a asp-action="EditQuiz"
                       asp-route-id="@quiz.QuizId"
                       class="btn btn-secondary btn-add">
                        Uredi
                    </a>

                    <form asp-action="DeleteQuiz"
                          asp-route-id="@quiz.QuizId"
                          method="post">
                        <button type="submit"
                                class="btn btn-secondary btn-add">
                            Izbriši
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>