@{
    var quizId = ViewBag.QuizId;
    ViewData["Title"] = "Dodaj vprašanje";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">❓</div>
        <h1>Dodaj vprašanje</h1>
        <p>Dodaj novo vprašanje v kviz</p>
    </div>

    <div class="form-card">
        <form method="post">

            <input type="hidden" name="quizId" value="@quizId" />

            <div class="form-group">
                <label>Besedilo vprašanja</label>
                <input type="text"
                       name="questionText"
                       class="form-input"
                       required />
            </div>

            <hr />

            @for (int i = 0; i < 4; i++)
            {
                <div class="form-group">
                    <label>Odgovor @(i + 1)</label>

                    <input type="text"
                           name="answers"
                           class="form-input"
                           required />

                    <div class="checkbox-group">
                        <input type="radio"
                               name="correctAnswerIndex"
                               value="@i"
                               required />
                        <label>Pravilni odgovor</label>
                    </div>
                </div>
            }

            <div class="form-actions">
                <a asp-action="Questions"
                   asp-route-id="@quizId"
                   class="btn btn-secondary">
                    Nazaj
                </a>

                <button type="submit" class="btn btn-primary">
                    Shrani vprašanje
                </button>
            </div>

        </form>
    </div>
</div>