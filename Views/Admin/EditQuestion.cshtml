@model Question

<div class="users-container">

    <div class="users-header">
        <div class="users-icon">✏️</div>
        <h1>Uredi vprašanje</h1>
        <p>Spremeni vprašanje in odgovore</p>

        <div class="users-top-actions">
            <a asp-action="Questions"
               asp-route-id="@Model.QuizId"
               class="btn btn-action btn-add">
                Nazaj
            </a>
        </div>
    </div>

    <div class="users-grid">
        <div class="user-card">

            <form method="post">

                <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

                <div class="user-card-header">
                    <div class="user-avatar">Q</div>

                    <div style="flex:1;">
                        <label><strong>Besedilo vprašanja</strong></label>
                        <input type="text"
                               name="Text"
                               value="@Model.Text"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="user-info">
                    <h4 style="margin-bottom:1rem;">Odgovori</h4>

                    @{
                        var answers = Model.Answers.ToList();
                    }

                    @for (int i = 0; i < answers.Count; i++)
                    {
                        <div class="info-row"
                             style="align-items:center; gap:10px; margin-bottom:10px;">

                            <input type="radio"
                                   name="correctAnswerIndex"
                                   value="@i"
                                   @(answers[i].IsCorrect ? "checked" : "")
                                   required />

                            <input type="text"
                                   name="answers"
                                   value="@answers[i].Text"
                                   class="form-control"
                                   required />

                            <span class="badge badge-user">
                                Pravilen
                            </span>
                        </div>
                    }
                </div>

                <div class="user-actions">
                    <button type="submit"
                            class="btn btn-action btn-add">
                        💾 Shrani spremembe
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
