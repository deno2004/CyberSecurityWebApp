@{
    ViewData["Title"] = "Statistika sistema";

    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
    var totalAdmins = ViewBag.TotalAdmins as int? ?? 0;
    var totalRegular = ViewBag.TotalRegularUsers as int? ?? 0;
    var totalQuizzes = ViewBag.TotalQuizzes as int? ?? 0;
    var totalQuestions = ViewBag.TotalQuestions as int? ?? 0;
    var totalAnswers = ViewBag.TotalAnswers as int? ?? 0;
    var avgQ = ViewBag.AvgQuestionsPerQuiz as double? ?? 0;

    // dynamic list from ViewBag
    var quizStats = ViewBag.QuizStats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}
<br />

<!-- Page title -->
<div class="stat-page-header">
    <div>
        <h1 class="stat-page-title">📊 Statistika sistema</h1>
        <p class="stat-page-sub">Pregled vsebine in aktivnosti platforme</p>
    </div>
</div>

<!-- ══════ KPI CARDS ══════ -->
<div class="kpi-grid">

    <div class="kpi-card kpi-blue">
        <div class="kpi-icon"><i class="bi bi-people-fill"></i></div>
        <div class="kpi-body">
            <div class="kpi-value">@totalUsers</div>
            <div class="kpi-label">Skupaj uporabnikov</div>
        </div>
        <div class="kpi-sub">
            <span class="kpi-pill kpi-pill-admin">@totalAdmins admin</span>
            <span class="kpi-pill kpi-pill-user">@totalRegular navadnih</span>
        </div>
    </div>

    <div class="kpi-card kpi-purple">
        <div class="kpi-icon"><i class="bi bi-journal-text"></i></div>
        <div class="kpi-body">
            <div class="kpi-value">@totalQuizzes</div>
            <div class="kpi-label">Skupaj kvizov</div>
        </div>
        <div class="kpi-sub">
            <span class="kpi-pill kpi-pill-neutral">Ø @avgQ vpr. / kviz</span>
        </div>
    </div>

    <div class="kpi-card kpi-teal">
        <div class="kpi-icon"><i class="bi bi-question-circle-fill"></i></div>
        <div class="kpi-body">
            <div class="kpi-value">@totalQuestions</div>
            <div class="kpi-label">Skupaj vprašanj</div>
        </div>
        <div class="kpi-sub">
            <span class="kpi-pill kpi-pill-neutral">v @totalQuizzes kvizih</span>
        </div>
    </div>

    <div class="kpi-card kpi-green">
        <div class="kpi-icon"><i class="bi bi-check2-square"></i></div>
        <div class="kpi-body">
            <div class="kpi-value">@totalAnswers</div>
            <div class="kpi-label">Skupaj odgovorov</div>
        </div>
        <div class="kpi-sub">
            <span class="kpi-pill kpi-pill-neutral">
                Ø @(totalQuestions > 0 ? Math.Round((double)totalAnswers / totalQuestions, 1) : 0) / vprašanje
            </span>
        </div>
    </div>

</div>

<!-- ══════ VSEBINA KVIZOV ══════ -->
<div class="stat-section">
    <div class="stat-section-header">
        <h2 class="stat-section-title">📝 Pregled kvizov</h2>
        <a href="/Admin/Quizzes" class="btn-stat-link">Upravljaj kvize →</a>
    </div>

    @if (!quizStats.Any())
    {
        <div class="stat-empty">
            <i class="bi bi-inbox"></i>
            <p>Ni kvizov v bazi.</p>
        </div>
    }
    else
    {
        <div class="stat-table-wrap">
            <table class="stat-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Naziv kviza</th>
                        <th>Vprašanj</th>
                        <th>Odgovorov</th>
                        <th>Prag za vpis (%)</th>
                        <th>Pokritost</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNum = 1;
                    }
                    @foreach (var q in quizStats)
                    {
                        int qCount = (int)q.QuestionCount;
                        int aCount = (int)q.AnswerCount;
                        int threshold = (int)q.PassThreshold;
                        // Coverage bar: avg answers per question vs ideal 4
                        double coverage = qCount > 0 ? Math.Min(100, Math.Round((double)aCount / (qCount * 4) * 100)) : 0;

                        <tr>
                            <td class="stat-row-num">@rowNum</td>
                            <td class="stat-quiz-title">@q.Title</td>
                            <td><span class="stat-badge stat-badge-teal">@qCount</span></td>
                            <td><span class="stat-badge stat-badge-purple">@aCount</span></td>
                            <td>
                                <span class="threshold-pill @(threshold >= 70 ? "threshold-high" : threshold >= 50 ? "threshold-mid" : "threshold-low")">
                                    @threshold%
                                </span>
                            </td>
                            <td>
                                <div class="mini-bar-wrap">
                                    <div class="mini-bar">
                                        <div class="mini-bar-fill" style="width:@coverage%"></div>
                                    </div>
                                    <span class="mini-bar-label">@coverage%</span>
                                </div>
                            </td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>

        <!-- Question count bar chart -->
        <div class="stat-chart-wrap">
            <div class="stat-chart-title">Število vprašanj po kvizu</div>
            <div class="bar-chart" id="barChart"></div>
        </div>
    }
</div>

<!-- ══════ UPORABNIKI ══════ -->
<div class="stat-section">
    <div class="stat-section-header">
        <h2 class="stat-section-title">👥 Sestava uporabnikov</h2>
        <a href="/Admin/Users" class="btn-stat-link">Upravljaj uporabnike →</a>
    </div>
    <div class="user-split">
        <!-- Donut chart (CSS only) -->
        <div class="donut-wrap">
            @{
                int adminPct = totalUsers > 0 ? (int)Math.Round((double)totalAdmins / totalUsers * 100) : 0;
                int regularPct = 100 - adminPct;
                // CSS conic-gradient degrees
                int adminDeg = (int)Math.Round(adminPct * 3.6);
            }
            <div class="donut" style="--admin-deg:@(adminDeg)deg">
                <div class="donut-hole">
                    <div class="donut-total">@totalUsers</div>
                    <div class="donut-total-label">skupaj</div>
                </div>
            </div>
            <div class="donut-legend">
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-admin"></span>
                    <span>Administratorji — <strong>@totalAdmins (@adminPct%)</strong></span>
                </div>
                <div class="donut-legend-item">
                    <span class="donut-dot donut-dot-user"></span>
                    <span>Navadni uporabniki — <strong>@totalRegular (@regularPct%)</strong></span>
                </div>
            </div>
        </div>
        <!-- Quick stats -->
        <div class="user-quick-stats">
            <div class="user-stat-row">
                <span class="user-stat-icon user-stat-icon-admin"><i class="bi bi-shield-fill"></i></span>
                <div>
                    <div class="user-stat-val">@totalAdmins</div>
                    <div class="user-stat-lbl">Administratorji</div>
                </div>
            </div>
            <div class="user-stat-row">
                <span class="user-stat-icon user-stat-icon-user"><i class="bi bi-person-fill"></i></span>
                <div>
                    <div class="user-stat-val">@totalRegular</div>
                    <div class="user-stat-lbl">Navadni uporabniki</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Build CSS bar chart from quiz data
    const quizData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        ((IEnumerable<dynamic>)ViewBag.QuizStats)
                                .Select(q => new { title = (string)q.Title, count = (int)q.QuestionCount })
                                .ToList()
                )
        );

    const chart = document.getElementById('barChart');
    if (chart && quizData.length) {
        const max = Math.max(...quizData.map(d => d.count), 1);
        quizData.forEach(d => {
            const pct = Math.round(d.count / max * 100);
            const bar = document.createElement('div');
            bar.className = 'bar-chart-item';
            bar.innerHTML = `
                <div class="bar-chart-label">${d.title}</div>
                <div class="bar-chart-track">
                    <div class="bar-chart-fill" style="width:0%" data-target="${pct}%">
                        <span class="bar-chart-val">${d.count}</span>
                    </div>
                </div>`;
            chart.appendChild(bar);
        });

        // Animate bars on load
        requestAnimationFrame(() => {
            document.querySelectorAll('.bar-chart-fill').forEach(b => {
                b.style.width = b.dataset.target;
            });
        });
    }
</script>

