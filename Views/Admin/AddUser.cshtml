@model User

@{
    ViewData["Title"] = "Dodaj uporabnika";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">➕</div>
        <h1>Dodaj uporabnika</h1>
        <p>Ustvarite nov uporabniški račun</p>
    </div>

    <div class="form-card">
        <form asp-action="AddUser" method="post">

            <div class="form-group">
                <label>Ime</label>
                <input asp-for="FirstName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Priimek</label>
                <input asp-for="LastName" class="form-input" />
            </div>

            <div class="form-group">
                <label>Uporabniško ime</label>
                <input asp-for="Username" class="form-input" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-input" />
            </div>

            <div class="form-group">
                <label>Geslo</label>
                <input asp-for="Password" type="password" class="form-input" />
            </div>

            <div class="form-group checkbox-group">
                <input asp-for="IsAdmin" type="checkbox" />
                <label>Administrator</label>
            </div>

            <div class="form-actions">
                <a asp-action="Users" class="btn btn-secondary">
                    Nazaj
                </a>

                <button type="submit" class="btn btn-primary">
                    Shrani uporabnika
                </button>
            </div>
        </form>
    </div>
</div>
