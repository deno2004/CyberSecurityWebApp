@model Quiz

@{
    ViewData["Title"] = "Uredi kviz";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">🧠</div>
        <h1>Uredi kviz</h1>
        <p>Posodobi podatke kviza</p>
    </div>

    <div class="form-card">
        <form asp-action="EditQuiz" method="post">
            <input type="hidden" asp-for="QuizId" />

            <div class="form-group">
                <label>Naslov kviza</label>
                <input asp-for="Title" class="form-input" />
            </div>

            <div class="form-group">
                <label>Opis</label>
                <textarea asp-for="Description"
                          class="form-input"
                          rows="3"></textarea>
            </div>

            <div class="form-actions">
                <a asp-action="Quizzes" class="btn btn-secondary">
                    Nazaj
                </a>

                <button type="submit" class="btn btn-primary">
                    Shrani spremembe
                </button>
            </div>
        </form>
    </div>
</div>