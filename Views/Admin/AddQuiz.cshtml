@model Quiz

@{
    ViewData["Title"] = "Dodaj kviz";
}

<div class="form-container">
    <div class="form-header">
        <div class="form-icon">🧠</div>
        <h1>Dodaj kviz</h1>
        <p>Ustvari nov kviz v sistemu</p>
    </div>

    <div class="form-card">
        <form asp-action="CreateQuiz" method="post">

            <div class="form-group">
                <label>Naslov kviza</label>
                <input asp-for="Title" class="form-input" />
            </div>

            <div class="form-group">
                <label>Opis</label>
                <textarea asp-for="Description"
                          class="form-input"
                          rows="3"></textarea>
            </div>

            <div class="form-actions">
                <a asp-action="Quizzes" class="btn btn-secondary">
                    Nazaj
                </a>

                <button type="submit" class="btn btn-primary">
                    Shrani kviz
                </button>
            </div>

        </form>
    </div>
</div>