@{
    ViewData["Title"] = "Admin Dashboard";
}

<br />

<div class="admin-hero">
    <h1>⚙️ Administratorska nadzorna plošča</h1>
    <p>Upravljanje vsebine, uporabnikov in kvizov sistema</p>
</div>

<div class="admin-grid">

    <div class="admin-card">
        <div class="admin-icon">👥</div>
        <h3>Upravljanje uporabnikov</h3>
        <p>Preglej, urejaj ali izbriši registrirane uporabnike.</p><br />
        <a href="/Admin/Users" class="btn btn-primary">Odpri uporabnike</a>
    </div>

    <div class="admin-card">
        <div class="admin-icon">📝</div>
        <h3>Upravljanje kvizov</h3>
        <p>Ustvari, urejaj ali odstrani obstoječe kvize.</p><br />
        <a href="/Admin/Quizzes" class="btn btn-primary">Upravljaj kvize</a>
    </div>

    <div class="admin-card">
        <div class="admin-icon">📊</div>
        <h3>Statistika sistema</h3>
        <p>Pregled rezultatov, število uporabnikov in aktivnosti.</p><br />
        <a href="/Admin/Statistics" class="btn btn-primary">Ogled statistike</a>
    </div>
</div>
