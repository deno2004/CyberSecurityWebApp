@model Quiz

@{
    ViewData["Title"] = "Vprašanja";
}

<div class="users-container">

    <div class="users-header">
        <div class="users-icon">❓</div>
        <h1>@Model.Title</h1>
        <p>Upravljanje vprašanj</p>

        <div class="users-top-actions">
            <a asp-action="AddQuestion"
               asp-route-quizId="@Model.QuizId"
               class="btn btn-secondary btn-add">
                ➕ Dodaj vprašanje
            </a>

            <a asp-action="Quizzes"
               class="btn btn-secondary btn-add">
                Nazaj
            </a>
        </div>
    </div>

    <div class="users-grid">
        @foreach (var question in Model.Questions)
        {
            <div class="user-card">

                <div class="user-card-header">
                    <div>
                        <h3>@question.Text</h3>
                        <p class="username">@question.Answers.Count odgovorov</p>
                    </div>
                </div>

                <div class="user-info">
                    @foreach (var answer in question.Answers)
                    {
                        <div class="info-row">
                            <span>@answer.Text</span>

                            @if (answer.IsCorrect)
                            {
                                <span class="badge badge-admin">
                                    ✔ Pravilno
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="user-actions">
                    <a asp-action="EditQuestion"
                       asp-route-id="@question.QuestionId"
                       class="btn btn-secondary btn-sm">
                        ✏️ Uredi
                    </a>

                    <form asp-action="DeleteQuestion"
                          asp-route-id="@question.QuestionId"
                          method="post">
                        <button type="submit"
                                class="btn btn-secondary btn-sm">
                            🗑 Izbriši
                        </button>
                    </form>
                </div>

            </div>
        }
    </div>
</div>
