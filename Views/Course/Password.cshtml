@model CyberSecurityWebApp.Models.Quiz
@{
    ViewData["Title"] = "Gesla in avtentikacija";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Domov</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Index">Tečaji</a></li>
        <li class="breadcrumb-item active">Gesla in avtentikacija</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <!-- Course Header -->
        <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg,#dc3545,#b02a37); color:white;">
            <div class="card-body p-4 d-flex align-items-center">
                <i class="bi bi-key-fill display-3 me-4 opacity-75"></i>
                <div>
                    <h1 class="fw-bold mb-1">Gesla in avtentikacija</h1>
                    <p class="mb-0 opacity-75">Naučite se ustvarjati in upravljati varna gesla</p>
                </div>
            </div>
        </div>

        <!-- Section 1: Theory -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold"><i class="bi bi-1-circle-fill text-danger me-2"></i>Moč gesel</h3>
            </div>
            <div class="card-body px-4 pb-4">
                <h5>Kaj naredi geslo šibko?</h5>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="card border-danger border-opacity-25 h-100">
                            <div class="card-body">
                                <h6 class="text-danger"><i class="bi bi-x-circle-fill me-2"></i>Šibka gesla</h6>
                                <ul class="list-unstyled text-muted small mb-0">
                                    <li>❌ <code>geslo123</code> – preprosto</li>
                                    <li>❌ <code>Janez1990</code> – osebni podatki</li>
                                    <li>❌ <code>abc123</code> – zaporedne kombinacije</li>
                                    <li>❌ <code>qwerty</code> – tipkovnični vzorci</li>
                                    <li>❌ <code>password</code> – pogosto geslo</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card border-success border-opacity-25 h-100">
                            <div class="card-body">
                                <h6 class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Močna gesla</h6>
                                <ul class="list-unstyled text-muted small mb-0">
                                    <li>✅ <code>T#9kL!mQ2@xZ</code> – dolgo + kompleksno</li>
                                    <li>✅ <code>Modri-Slon-Leti-Visoko</code> – geslovni stavek</li>
                                    <li>✅ Vsaj 12 znakov</li>
                                    <li>✅ Mešanica vrst znakov</li>
                                    <li>✅ Unikatno za vsak račun</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <h5>Entropija gesla</h5>
                <p>Entropija meri nepredvidljivost gesla. Računamo jo z formulo: <strong>E = L × log₂(C)</strong>, kjer je <em>L</em> dolžina gesla in <em>C</em> velikost abecede znakov.</p>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead class="table-dark">
                            <tr><th>Tip znakov</th><th>Abeceda</th><th>Primerjava (12 znakov)</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Samo male črke</td><td>26</td><td>~56 bitov</td></tr>
                            <tr><td>+ Velike črke</td><td>52</td><td>~68 bitov</td></tr>
                            <tr><td>+ Številke</td><td>62</td><td>~71 bitov</td></tr>
                            <tr class="table-success"><td>+ Posebni znaki</td><td>94</td><td>~79 bitov ✓</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section 2: Password Strength Checker -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold"><i class="bi bi-2-circle-fill text-danger me-2"></i>Preverjevalnik moči gesla</h3>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="mb-3">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input type="text" id="pwdCheck" class="form-control" placeholder="Vnesite geslo za preveritev..." oninput="analyzePassword(this.value)">
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordField('pwdCheck')"><i class="bi bi-eye"></i></button>
                    </div>
                </div>

                <!-- Strength bar -->
                <div class="mb-3">
                    <div class="progress mb-2" style="height: 12px; border-radius: 6px;">
                        <div id="strengthBar" class="progress-bar rounded" style="width: 0%; transition: width 0.3s;"></div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span id="strengthLabel" class="fw-bold"></span>
                        <span id="entropyLabel" class="text-muted small"></span>
                    </div>
                </div>

                <!-- Details -->
                <div id="strengthDetails" class="d-none">
                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-3">
                            <div id="chkLength" class="card text-center border-secondary">
                                <div class="card-body py-2 px-1">
                                    <i class="bi bi-rulers fs-4"></i>
                                    <div class="small mt-1">Dolžina</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div id="chkUpper" class="card text-center border-secondary">
                                <div class="card-body py-2 px-1">
                                    <i class="bi bi-type-h1 fs-4"></i>
                                    <div class="small mt-1">Velike črke</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div id="chkDigit" class="card text-center border-secondary">
                                <div class="card-body py-2 px-1">
                                    <i class="bi bi-123 fs-4"></i>
                                    <div class="small mt-1">Številke</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div id="chkSpecial" class="card text-center border-secondary">
                                <div class="card-body py-2 px-1">
                                    <i class="bi bi-asterisk fs-4"></i>
                                    <div class="small mt-1">Posebni znaki</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <ul id="issuesList" class="list-unstyled mb-0"></ul>
                </div>
            </div>
        </div>

        <!-- Section 3: Password Generator -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold"><i class="bi bi-3-circle-fill text-danger me-2"></i>Generator varnih gesel</h3>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Dolžina: <span id="lengthVal">16</span> znakov</label>
                        <input type="range" class="form-range" id="genLength" min="8" max="32" value="16"
                               oninput="document.getElementById('lengthVal').textContent = this.value">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Možnosti:</label>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="inclUpper" checked>
                                <label class="form-check-label" for="inclUpper">ABC</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="inclLower" checked>
                                <label class="form-check-label" for="inclLower">abc</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="inclDigits" checked>
                                <label class="form-check-label" for="inclDigits">123</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="inclSpecial" checked>
                                <label class="form-check-label" for="inclSpecial">!#</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <input type="text" id="generatedPwd" class="form-control form-control-lg font-monospace"
                           readonly placeholder="Generirano geslo se bo pojavilo tukaj...">
                    <button class="btn btn-outline-secondary" onclick="copyToClipboard('generatedPwd')" title="Kopiraj">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <button class="btn btn-danger" onclick="generatePassword()">
                    <i class="bi bi-arrow-clockwise me-2"></i>Generiraj geslo
                </button>
                <small class="text-muted ms-3" id="copyFeedback"></small>
            </div>
        </div>

        <!-- Section 4: Excel Upload -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold"><i class="bi bi-4-circle-fill text-danger me-2"></i>Analiza gesel iz Excel datoteke</h3>
            </div>
            <div class="card-body px-4 pb-4">
                <p class="text-muted">Naložite Excel datoteko (.xlsx) z gesli v prvem stolpcu za množično analizo moči.</p>
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadExcel">
                    <div class="mb-3">
                        <input type="file" class="form-control" name="excelFile" accept=".xlsx" required>
                        <div class="form-text">Prva vrstica = glava, gesla v stolpcu A. Max 200 gesel.</div>
                    </div>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-file-earmark-excel me-2"></i>Analiziraj gesla
                    </button>
                </form>

                
            </div>
        </div>

        <!-- Section 5: Best Practices PDF -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h3 class="fw-bold"><i class="bi bi-5-circle-fill text-danger me-2"></i>Najboljše prakse – PDF</h3>
            </div>
            <div class="card-body px-4 pb-4">
                <p>Prenesite povzetek najboljših praks za upravljanje gesel.</p>
                <a asp-page="/Courses/PasswordsPdf" class="btn btn-outline-danger" target="_blank">
                    <i class="bi bi-file-pdf me-2"></i>Prenesi PDF povzetek
                </a>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4 sticky-top" style="top: 80px;">
            <div class="card-header bg-danger text-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>O tečaju</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0"><i class="bi bi-clock me-2 text-muted"></i>Čas: ~20 minut</li>
                    <li class="list-group-item px-0"><i class="bi bi-patch-question me-2 text-muted"></i>15 vprašanj v kvizu</li>
                    <li class="list-group-item px-0"><i class="bi bi-check2-circle me-2 text-muted"></i>70% za uspešen zaključek</li>
                </ul>
                
            </div>
        </div>

        <!-- Key Points -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-lightbulb me-2"></i>Ključne točke</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Min. 12 znakov</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Mešanica znakov</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Unikatno geslo</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Upravitelj gesel</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>2FA vedno</li>
                    <li class="mb-2"><i class="bi bi-x-circle-fill text-danger me-2"></i>Ne osebnih podatkov</li>
                    <li class="mb-0"><i class="bi bi-x-circle-fill text-danger me-2"></i>Ne istih gesel</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const commonPasswords = ["password","123456","qwerty","abc123","geslo","geslo123","admin","test"];

        function analyzePassword(pwd) {
            const details = document.getElementById('strengthDetails');
            if (!pwd) { document.getElementById('strengthBar').style.width = '0%'; document.getElementById('strengthLabel').textContent = ''; details.classList.add('d-none'); return; }
            details.classList.remove('d-none');

            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasDigit = /\d/.test(pwd);
            const hasSpecial = /[^A-Za-z0-9]/.test(pwd);
            const isCommon = commonPasswords.some(c => pwd.toLowerCase() === c);

            let charset = 0;
            if (hasLower) charset += 26;
            if (hasUpper) charset += 26;
            if (hasDigit) charset += 10;
            if (hasSpecial) charset += 32;
            if (charset === 0) charset = 26;
            const entropy = (pwd.length * Math.log2(charset)).toFixed(1);

            let score = 0;
            if (pwd.length >= 8) score++;
            if (pwd.length >= 12) score++;
            if (hasUpper && hasLower) score++;
            if (hasDigit) score++;
            if (hasSpecial) score++;
            if (isCommon) score = Math.max(0, score - 2);

            const levels = [
                {w:'10%',cls:'bg-danger',lbl:'Zelo šibko 🔴'},
                {w:'25%',cls:'bg-danger',lbl:'Šibko 🔴'},
                {w:'50%',cls:'bg-warning',lbl:'Zadovoljivo 🟡'},
                {w:'70%',cls:'bg-info',lbl:'Dobro 🔵'},
                {w:'85%',cls:'bg-primary',lbl:'Močno 💪'},
                {w:'100%',cls:'bg-success',lbl:'Odlično! 🟢'}
            ];
            const l = levels[Math.min(score, 5)];
            const bar = document.getElementById('strengthBar');
            bar.style.width = l.w; bar.className = 'progress-bar rounded ' + l.cls;
            document.getElementById('strengthLabel').textContent = l.lbl;
            document.getElementById('entropyLabel').textContent = `Entropija: ${entropy} bit`;

            function setChk(id, ok) {
                const el = document.getElementById(id);
                el.className = 'card text-center border-' + (ok ? 'success text-success' : 'danger text-danger');
            }
            setChk('chkLength', pwd.length >= 8);
            setChk('chkUpper', hasUpper);
            setChk('chkDigit', hasDigit);
            setChk('chkSpecial', hasSpecial);

            const issues = [];
            if (isCommon) issues.push({t:'danger',m:'⚠️ To je pogosto geslo!'});
            if (pwd.length < 8) issues.push({t:'danger',m:'Geslo je prekratko'});
            if (!hasUpper) issues.push({t:'warning',m:'Dodajte veliko črko'});
            if (!hasDigit) issues.push({t:'warning',m:'Dodajte številko'});
            if (!hasSpecial) issues.push({t:'warning',m:'Dodajte posebni znak'});
            if (score >= 4) issues.push({t:'success',m:'✅ Geslo je varno!'});

            document.getElementById('issuesList').innerHTML = issues.map(i =>
                `<li class="text-${i.t} small mb-1"><i class="bi bi-arrow-right me-1"></i>${i.m}</li>`
            ).join('');
        }

        function generatePassword() {
            const len = parseInt(document.getElementById('genLength').value);
            const inclUpper = document.getElementById('inclUpper').checked;
            const inclLower = document.getElementById('inclLower').checked;
            const inclDigits = document.getElementById('inclDigits').checked;
            const inclSpecial = document.getElementById('inclSpecial').checked;

            let pool = '';
            const mandatory = [];
            if (inclLower) { pool += 'abcdefghijklmnopqrstuvwxyz'; mandatory.push(randFrom('abcdefghijklmnopqrstuvwxyz')); }
            if (inclUpper) { pool += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'; mandatory.push(randFrom('ABCDEFGHIJKLMNOPQRSTUVWXYZ')); }
            if (inclDigits) { pool += '0123456789'; mandatory.push(randFrom('0123456789')); }
            if (inclSpecial) { pool += '!#$%^&*()-_=+[]{}|;:,.<>?'; mandatory.push(randFrom('!#$%^&*()-_=+[]{}|;:,.<>?')); }
            if (!pool) pool = 'abcdefghijklmnopqrstuvwxyz';

            let pwd = [...mandatory];
            while (pwd.length < len) pwd.push(randFrom(pool));
            pwd = pwd.sort(() => Math.random() - 0.5);
            document.getElementById('generatedPwd').value = pwd.join('');
            document.getElementById('copyFeedback').textContent = '';
        }

        function randFrom(s) { return s[Math.floor(Math.random() * s.length)]; }

        function copyToClipboard(id) {
            const val = document.getElementById(id).value;
            if (!val) return;
            navigator.clipboard.writeText(val).then(() => {
                document.getElementById('copyFeedback').textContent = '✅ Kopirano!';
                setTimeout(() => document.getElementById('copyFeedback').textContent = '', 2000);
            });
        }

        function togglePasswordField(id) {
            const el = document.getElementById(id);
            el.type = el.type === 'password' ? 'text' : 'password';
        }

        generatePassword();
    </script>
}

