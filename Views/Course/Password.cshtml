@model CyberSecurityWebApp.Models.Quiz
@{
    ViewData["Title"] = "Gesla in avtentikacija";
}

<div class="row g-4">
    <div class="col-lg-8">
        <br />
        <!-- Course Header -->
        <div class="course-hero mb-4">
            <div class="course-hero-icon">
				<i class="bi bi-key-fill">🔑</i>
            </div>
            <div>
                <h1 class="course-title">Varnost gesel</h1>
                <p class="course-subtitle">Naučite se ustvarjati močna gesla in zaščititi svoje račune</p>
            </div>
        </div>

        <!-- Section 1: Theory -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">01</span>
                <h3 class="section-title">Moč gesel</h3>
            </div>
            <div class="section-body">
                <h5 class="subsection-title">Kaj naredi geslo šibko?</h5>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="compare-card compare-bad">
                            <div class="compare-card-header">
                                <span class="compare-icon">✕</span>
                                <span>Šibka gesla</span>
                            </div>
                            <ul class="compare-list">
                                <li><code>geslo123</code> — preprosto</li>
                                <li><code>Janez1990</code> — osebni podatki</li>
                                <li><code>abc123</code> — zaporedne kombinacije</li>
                                <li><code>qwerty</code> — tipkovnični vzorci</li>
                                <li><code>password</code> — pogosto geslo</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="compare-card compare-good">
                            <div class="compare-card-header">
                                <span class="compare-icon">✓</span>
                                <span>Močna gesla</span>
                            </div>
                            <ul class="compare-list">
                                <li><code>T#9kL!mQ2@xZ</code> — dolgo + kompleksno</li>
                                <li><code>Modri-Slon-Leti-Visoko</code> — stavek</li>
                                <li>Vsaj 12 znakov</li>
                                <li>Mešanica vrst znakov</li>
                                <li>Unikatno za vsak račun</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <h5 class="subsection-title">Entropija gesla</h5>
                <p class="body-text">Entropija meri nepredvidljivost gesla. Računamo jo z formulo: <strong>E = L × log₂(C)</strong>, kjer je <em>L</em> dolžina in <em>C</em> velikost abecede znakov.</p>
                <div class="table-responsive">
                    <table class="styled-table">
                        <thead>
                            <tr><th>Tip znakov</th><th>Abeceda</th><th>12 znakov</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Samo male črke</td><td>26</td><td>~56 bitov</td></tr>
                            <tr><td>+ Velike črke</td><td>52</td><td>~68 bitov</td></tr>
                            <tr><td>+ Številke</td><td>62</td><td>~71 bitov</td></tr>
                            <tr class="table-row-highlight"><td>+ Posebni znaki</td><td>94</td><td>~79 bitov ✓</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section 2: Strength Checker -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">02</span>
                <h3 class="section-title">Preverjevalnik moči gesla</h3>
            </div>
            <div class="section-body">
                <div class="input-row mb-3">
                    <span class="input-icon"><i class="bi bi-key"></i></span>
                    <input type="text" id="pwdCheck" class="styled-input" placeholder="Vnesite geslo za preveritev..." oninput="analyzePassword(this.value)">
                    <button class="input-toggle-btn" type="button" onclick="togglePasswordField('pwdCheck')">
                        <i class="bi bi-eye"></i> Prikaži
                    </button>
                </div>

                <div class="strength-wrap mb-3">
                    <div class="strength-track">
                        <div id="strengthBar" class="strength-fill" style="width:0%"></div>
                    </div>
                    <div class="strength-meta">
                        <span id="strengthLabel" class="strength-label"></span>
                        <span id="entropyLabel" class="entropy-label"></span>
                    </div>
                </div>

                <div id="strengthDetails" class="d-none">
                    <div class="criteria-grid mb-3">
                        <div id="chkLength" class="criteria-chip">
                            <i class="bi bi-rulers"></i>
                            <span>Dolžina</span>
                        </div>
                        <div id="chkUpper" class="criteria-chip">
                            <i class="bi bi-type-h1"></i>
                            <span>Velike črke</span>
                        </div>
                        <div id="chkDigit" class="criteria-chip">
                            <i class="bi bi-123"></i>
                            <span>Številke</span>
                        </div>
                        <div id="chkSpecial" class="criteria-chip">
                            <i class="bi bi-asterisk"></i>
                            <span>Posebni znaki</span>
                        </div>
                    </div>
                    <ul id="issuesList" class="issues-list"></ul>
                </div>
            </div>
        </div>

        <!-- Section 3: Generator -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">03</span>
                <h3 class="section-title">Generator varnih gesel</h3>
            </div>
            <div class="section-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="field-label">Dolžina: <strong id="lengthVal">16</strong> znakov</label>
                        <input type="range" class="styled-range" id="genLength" min="8" max="32" value="16"
                               oninput="document.getElementById('lengthVal').textContent = this.value">
                    </div>
                    <div class="col-md-6">
                        <label class="field-label">Možnosti:</label>
                        <div class="checkbox-row">
                            <label class="toggle-pill">
                                <input type="checkbox" id="inclUpper" checked>
                                <span>ABC</span>
                            </label>
                            <label class="toggle-pill">
                                <input type="checkbox" id="inclLower" checked>
                                <span>abc</span>
                            </label>
                            <label class="toggle-pill">
                                <input type="checkbox" id="inclDigits" checked>
                                <span>123</span>
                            </label>
                            <label class="toggle-pill">
                                <input type="checkbox" id="inclSpecial" checked>
                                <span>!#</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="generated-row mb-3">
                    <input type="text" id="generatedPwd" class="generated-input" readonly placeholder="Generirano geslo...">
                    <button class="copy-btn" onclick="copyToClipboard('generatedPwd')" title="Kopiraj">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button class="btn-primary-red" onclick="generatePassword()">
                        <i class="bi bi-arrow-clockwise"></i> Generiraj geslo
                    </button>
                    <small id="copyFeedback" class="copy-feedback"></small>
                </div>
            </div>
        </div>

        <!-- Section 4: Excel Upload -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">04</span>
                <h3 class="section-title">Analiza gesel iz Excel datoteke</h3>
            </div>
            <div class="section-body">
                <p class="body-text">Naložite Excel datoteko (.xlsx) z gesli v prvem stolpcu za množično analizo moči.</p>
                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadExcel">
                    <div class="mb-3">
                        <input type="file" class="file-input" name="excelFile" accept=".xlsx" required>
                        <div class="file-hint">Prva vrstica = glava, gesla v stolpcu A. Max 200 gesel.</div>
                    </div>
                    <button type="submit" class="btn-primary-red">
                        <i class="bi bi-file-earmark-excel"></i> Analiziraj gesla
                    </button>
                </form>
            </div>
        </div>

        <!-- Section 5: PDF -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">05</span>
                <h3 class="section-title">Najboljše prakse – PDF</h3>
            </div>
            <div class="section-body">
                <p class="body-text">Prenesite povzetek najboljših praks za upravljanje gesel.</p>
                <a asp-page="/Courses/PasswordsPdf" class="btn-outline-red" target="_blank">
                    <i class="bi bi-file-pdf"></i> Prenesi PDF povzetek
                </a>
            </div>
        </div>

    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="sidebar-card">
            <div class="sidebar-header">
                <i class="bi bi-shield-check me-2"></i> Ključne točke
            </div>
            <ul class="sidebar-list">
                <li class="sidebar-item sidebar-ok"><i class="bi bi-check-circle-fill"></i> Min. 12 znakov</li>
                <li class="sidebar-item sidebar-ok"><i class="bi bi-check-circle-fill"></i> Mešanica znakov</li>
                <li class="sidebar-item sidebar-ok"><i class="bi bi-check-circle-fill"></i> Unikatno geslo</li>
                <li class="sidebar-item sidebar-ok"><i class="bi bi-check-circle-fill"></i> Upravitelj gesel</li>
                <li class="sidebar-item sidebar-ok"><i class="bi bi-check-circle-fill"></i> 2FA vedno</li>
                <li class="sidebar-item sidebar-no"><i class="bi bi-x-circle-fill"></i> Ne osebnih podatkov</li>
                <li class="sidebar-item sidebar-no"><i class="bi bi-x-circle-fill"></i> Ne istih gesel</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const commonPasswords = ["password","123456","qwerty","abc123","geslo","geslo123","admin","test"];

        function analyzePassword(pwd) {
            const details = document.getElementById('strengthDetails');
            if (!pwd) {
                document.getElementById('strengthBar').style.width = '0%';
                document.getElementById('strengthLabel').textContent = '';
                details.classList.add('d-none');
                return;
            }
            details.classList.remove('d-none');

            const hasUpper = /[A-Z]/.test(pwd);
            const hasLower = /[a-z]/.test(pwd);
            const hasDigit = /\d/.test(pwd);
            const hasSpecial = /[^A-Za-z0-9]/.test(pwd);
            const isCommon = commonPasswords.some(c => pwd.toLowerCase() === c);

            let charset = 0;
            if (hasLower) charset += 26;
            if (hasUpper) charset += 26;
            if (hasDigit) charset += 10;
            if (hasSpecial) charset += 32;
            if (charset === 0) charset = 26;
            const entropy = (pwd.length * Math.log2(charset)).toFixed(1);

            let score = 0;
            if (pwd.length >= 8) score++;
            if (pwd.length >= 12) score++;
            if (hasUpper && hasLower) score++;
            if (hasDigit) score++;
            if (hasSpecial) score++;
            if (isCommon) score = Math.max(0, score - 2);

            const levels = [
                { w: '10%', color: '#dc3545', lbl: 'Zelo šibko 🔴' },
                { w: '25%', color: '#dc3545', lbl: 'Šibko 🔴' },
                { w: '50%', color: '#ffc107', lbl: 'Zadovoljivo 🟡' },
                { w: '70%', color: '#0dcaf0', lbl: 'Dobro 🔵' },
                { w: '85%', color: '#0d6efd', lbl: 'Močno 💪' },
                { w: '100%', color: '#198754', lbl: 'Odlično! 🟢' }
            ];
            const l = levels[Math.min(score, 5)];
            const bar = document.getElementById('strengthBar');
            bar.style.width = l.w;
            bar.style.background = l.color;
            document.getElementById('strengthLabel').textContent = l.lbl;
            document.getElementById('entropyLabel').textContent = `Entropija: ${entropy} bit`;

            function setChk(id, ok) {
                const el = document.getElementById(id);
                el.classList.toggle('criteria-ok', ok);
                el.classList.toggle('criteria-fail', !ok);
            }
            setChk('chkLength', pwd.length >= 8);
            setChk('chkUpper', hasUpper);
            setChk('chkDigit', hasDigit);
            setChk('chkSpecial', hasSpecial);

            const issues = [];
            if (isCommon) issues.push({ t: 'danger', m: '⚠️ To je pogosto geslo!' });
            if (pwd.length < 8) issues.push({ t: 'danger', m: 'Geslo je prekratko' });
            if (!hasUpper) issues.push({ t: 'warning', m: 'Dodajte veliko črko' });
            if (!hasDigit) issues.push({ t: 'warning', m: 'Dodajte številko' });
            if (!hasSpecial) issues.push({ t: 'warning', m: 'Dodajte posebni znak' });
            if (score >= 4) issues.push({ t: 'success', m: '✅ Geslo je varno!' });

            const colors = { danger: '#dc3545', warning: '#ffc107', success: '#198754' };
            document.getElementById('issuesList').innerHTML = issues.map(i =>
                `<li style="color:${colors[i.t]}" class="issue-item"><i class="bi bi-arrow-right-short"></i>${i.m}</li>`
            ).join('');
        }

        function generatePassword() {
            const len = parseInt(document.getElementById('genLength').value);
            const inclUpper = document.getElementById('inclUpper').checked;
            const inclLower = document.getElementById('inclLower').checked;
            const inclDigits = document.getElementById('inclDigits').checked;
            const inclSpecial = document.getElementById('inclSpecial').checked;

            let pool = '';
            const mandatory = [];
            if (inclLower)   { pool += 'abcdefghijklmnopqrstuvwxyz'; mandatory.push(randFrom('abcdefghijklmnopqrstuvwxyz')); }
            if (inclUpper)   { pool += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'; mandatory.push(randFrom('ABCDEFGHIJKLMNOPQRSTUVWXYZ')); }
            if (inclDigits)  { pool += '0123456789';                  mandatory.push(randFrom('0123456789')); }
            if (inclSpecial) { pool += '!#$%^&*()-_=+[]{}|;:,.<>?';  mandatory.push(randFrom('!#$%^&*()-_=+[]{}|;:,.<>?')); }
            if (!pool) pool = 'abcdefghijklmnopqrstuvwxyz';

            let pwd = [...mandatory];
            while (pwd.length < len) pwd.push(randFrom(pool));
            pwd = pwd.sort(() => Math.random() - 0.5);
            document.getElementById('generatedPwd').value = pwd.join('');
            document.getElementById('copyFeedback').textContent = '';
        }

        function randFrom(s) { return s[Math.floor(Math.random() * s.length)]; }

        function copyToClipboard(id) {
            const val = document.getElementById(id).value;
            if (!val) return;
            navigator.clipboard.writeText(val).then(() => {
                const fb = document.getElementById('copyFeedback');
                fb.textContent = '✅ Kopirano!';
                setTimeout(() => fb.textContent = '', 2000);
            });
        }

        function togglePasswordField(id) {
            const el = document.getElementById(id);
            el.type = el.type === 'password' ? 'text' : 'password';
        }

        generatePassword();
    </script>
}

<style>
    /* ══════════════════════════════════════
           COURSE HERO
        ══════════════════════════════════════ */
    .course-hero {
        display: flex;
        align-items: center;
        gap: 20px;
        background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);
        border-radius: 16px;
        padding: 28px 32px;
        box-shadow: 0 8px 24px rgba(220,53,69,0.25);
    }

    .course-hero-icon {
        font-size: 2.6rem;
        color: rgba(255,255,255,0.9);
        flex-shrink: 0;
        background: rgba(255,255,255,0.15);
        width: 64px;
        height: 64px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .course-title {
        font-size: 1.65rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 4px;
        letter-spacing: -0.02em;
    }

    .course-subtitle {
        color: rgba(255,255,255,0.82);
        font-size: 0.92rem;
        margin: 0;
    }

    /* ══════════════════════════════════════
           SECTION CARDS
        ══════════════════════════════════════ */
    .section-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: box-shadow 0.2s;
    }

        .section-card:hover {
            box-shadow: 0 6px 24px rgba(0,0,0,0.09);
        }

    .section-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 28px;
        border-bottom: 1px solid #f4f4f4;
    }

    .section-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #dc3545;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 800;
        border-radius: 10px;
        letter-spacing: 0.04em;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .section-body {
        padding: 24px 28px;
    }

    .subsection-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 14px;
    }

    .body-text {
        font-size: 0.93rem;
        color: #555;
        line-height: 1.6;
        margin-bottom: 14px;
    }

    /* ══════════════════════════════════════
           COMPARE CARDS
        ══════════════════════════════════════ */
    .compare-card {
        border-radius: 12px;
        padding: 16px 18px;
        height: 100%;
    }

    .compare-bad {
        background: #fff7f7;
        border: 1.5px solid #f5c0c5;
    }

    .compare-good {
        background: #f4fff7;
        border: 1.5px solid #b0dfc0;
    }

    .compare-card-header {
