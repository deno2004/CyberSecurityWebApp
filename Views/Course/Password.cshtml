        background: #d8f3dc;
        font-weight: 600;
        color: #155724;
    }

    /* ══════════════════════════════════════
           PASSWORD INPUT ROW
        ══════════════════════════════════════ */
    .input-row {
        display: flex;
        align-items: center;
        border: 1.5px solid #e2e2e2;
        border-radius: 10px;
        overflow: hidden;
