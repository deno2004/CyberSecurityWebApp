            background: #f0f0f0;
        }

    /* ══════════════════════════════════════
           STRENGTH BAR
        ══════════════════════════════════════ */
    .strength-wrap {
    }

    .strength-track {
        height: 8px;
        background: #eee;
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .strength-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 0.35s ease, background 0.35s ease;
    }

    .strength-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .strength-label {
        font-size: 0.88rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .entropy-label {
        font-size: 0.8rem;
        color: #999;
    }

    /* ══════════════════════════════════════
           CRITERIA CHIPS
        ══════════════════════════════════════ */
    .criteria-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .criteria-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 12px 8px;
