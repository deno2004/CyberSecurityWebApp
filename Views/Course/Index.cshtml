@model IEnumerable<CyberSecurityWebApp.Models.Course>
@{
    ViewData["Title"] = "Tečaji";

    // Color theme per category
    (string bg, string border, string accent, string btn) GetTheme(string category) => category switch
    {
        "Gesla" => ("#eff6ff", "#bfdbfe", "#1d4ed8", "theme-blue"),
        "Phishing" => ("#fffbeb", "#fde68a", "#b45309", "theme-amber"),
        "Internet" => ("#f0fdf4", "#bbf7d0", "#166534", "theme-green"),
        _ => ("#f9fafb", "#e5e7eb", "#374151", "theme-gray")
    };
}
<br />
<!-- Page header -->
<div class="courses-page-header">
    <div class="courses-header-text">
        <h1 class="courses-title">🎓 Tečaji kibernetske varnosti</h1>
        <p class="courses-subtitle">Izboljšajte svoje znanje skozi interaktivne tečaje in praktične primere</p>
    </div>
    <div class="courses-header-badge">
        <span class="courses-count-badge">@Model.Count() tečaji</span>
    </div>
</div>

<!-- Courses grid -->
@if (!Model.Any())
{
    <div class="courses-empty">
        <span class="courses-empty-icon">🎓</span>
        <p>Trenutno ni na voljo nobenega tečaja.</p>
    </div>
}
else
{
    <div class="courses-grid">
        @foreach (var course in Model)
        {
            var theme = GetTheme(course.Category);
            string coursePage;
            switch (course.Category)
            {
                case "Gesla":
                    coursePage = "/Course/Password";
                    break;
                case "Phishing":
                    coursePage = "/Course/Phishing";
                    break;
                case "Internet":
                    coursePage = "/Course/Internet";
                    break;
                default:
                    coursePage = "/Course";
                    break;
            }

            <div class="course-card @theme.btn"
                 style="--card-bg:@theme.bg; --card-border:@theme.border; --card-accent:@theme.accent;">

                <!-- Top stripe -->
                <div class="course-card-stripe"></div>

                <!-- Header -->
                <div class="course-card-header">
                    <div class="course-icon-wrap">
                        <span class="course-icon-emoji">@course.Icon</span>
                    </div>
                    <div class="course-header-meta">
                        <span class="course-category-pill">@course.Category</span>
                    </div>
                </div>

                <!-- Body -->
                <div class="course-card-body">
                    <h3 class="course-name">@course.Name</h3>
                    <p class="course-desc">@course.Description</p>

                    <div class="course-meta-row">
                        <span class="course-meta-item">
                            <i class="bi bi-book"></i> Lekcije
                        </span>
                        <span class="course-meta-item">
                            <i class="bi bi-patch-check"></i> Certifikat
                        </span>
                        <span class="course-meta-item">
                            <i class="bi bi-pencil-square"></i> Kviz
                        </span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="course-card-actions">
                    <a href="@coursePage" class="btn-course-primary">
                        <i class="bi bi-book-open"></i> Odpri tečaj
                    </a>
                    <a href="/Quiz/Start/@course.QuizId" class="btn-course-secondary">
                        <i class="bi bi-brain"></i> Reši kviz
                    </a>
                </div>

            </div>
        }
    </div>
}

<style>
    /* ══════════════════════════════════════
           PAGE HEADER
        ══════════════════════════════════════ */
    .courses-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 32px;
    }

    .courses-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #1a1a1a;
        margin: 0 0 6px;
        letter-spacing: -0.02em;
    }

    .courses-subtitle {
        font-size: 0.93rem;
        color: #777;
        margin: 0;
        max-width: 520px;
    }

    .courses-count-badge {
        display: inline-block;
        background: #f3f4f6;
        color: #6b7280;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 99px;
        border: 1.5px solid #e5e7eb;
        white-space: nowrap;
    }

    /* ══════════════════════════════════════
           GRID
        ══════════════════════════════════════ */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    /* ══════════════════════════════════════
           COURSE CARD
        ══════════════════════════════════════ */
    .course-card {
        background: var(--card-bg);
        border: 1.5px solid var(--card-border);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        position: relative;
    }

        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 36px rgba(0,0,0,0.1);
        }

    /* Colored top stripe */
    .course-card-stripe {
        height: 4px;
        background: var(--card-accent);
        opacity: 0.7;
    }

    /* ── Header ── */
    .course-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 20px 22px 12px;
    }

    .course-icon-wrap {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: rgba(255,255,255,0.7);
        border: 1.5px solid var(--card-border);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .course-icon-emoji {
        font-size: 1.7rem;
        line-height: 1;
    }

    .course-category-pill {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--card-accent);
        background: rgba(255,255,255,0.8);
        border: 1.5px solid var(--card-border);
        padding: 4px 12px;
        border-radius: 99px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    /* ── Body ── */
    .course-card-body {
        padding: 4px 22px 18px;
        flex: 1;
    }

    .course-name {
        font-size: 1.08rem;
        font-weight: 800;
        color: #1a1a1a;
        margin: 0 0 8px;
        letter-spacing: -0.01em;
        line-height: 1.3;
    }

    .course-desc {
        font-size: 0.86rem;
        color: #666;
        line-height: 1.6;
        margin: 0 0 16px;
    }

    .course-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .course-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--card-accent);
        background: rgba(255,255,255,0.6);
        border: 1px solid var(--card-border);
        padding: 4px 10px;
        border-radius: 99px;
    }

    /* ── Actions ── */
    .course-card-actions {
        display: flex;
        gap: 8px;
        padding: 14px 22px 20px;
    }

    .btn-course-primary,
    .btn-course-secondary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.86rem;
        font-weight: 700;
        padding: 10px 16px;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.18s;
        border: none;
        cursor: pointer;
    }

    .btn-course-primary {
        flex: 1;
        justify-content: center;
        background: var(--card-accent);
        color: #fff;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
    }

        .btn-course-primary:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
            color: #fff;
            box-shadow: 0 6px 18px rgba(0,0,0,0.18);
        }

    .btn-course-secondary {
        flex: 1;
        justify-content: center;
        background: rgba(255,255,255,0.75);
        color: var(--card-accent);
        border: 1.5px solid var(--card-border);
    }

        .btn-course-secondary:hover {
            background: #fff;
            color: var(--card-accent);
            border-color: var(--card-accent);
        }

    /* ══════════════════════════════════════
           EMPTY STATE
        ══════════════════════════════════════ */
    .courses-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        gap: 14px;
        text-align: center;
        color: #aaa;
    }

    .courses-empty-icon {
        font-size: 3.5rem;
    }

    .courses-empty p {
        font-size: 0.95rem;
        margin: 0;
    }

    /* ══════════════════════════════════════
           DARK MODE
        ══════════════════════════════════════ */
    body.dark-mode .courses-title {
        color: #e4e4e4;
    }

    body.dark-mode .courses-subtitle {
        color: #888;
    }

    body.dark-mode .courses-count-badge {
        background: #252525;
        border-color: #333;
        color: white;
    }

    body.dark-mode .course-card.theme-blue {
        --card-bg: #1a2235;
        --card-border: #1d3a6e;
        --card-accent: #60a5fa;
    }

    body.dark-mode .course-card.theme-amber {
        --card-bg: #2a1f0a;
        --card-border: #5c3d0a;
        --card-accent: #fbbf24;
    }

    body.dark-mode .course-card.theme-green {
        --card-bg: #0d2518;
        --card-border: #14532d;
        --card-accent: #4ade80;
    }

    body.dark-mode .course-card.theme-gray {
        --card-bg: #1e1e1e;
        --card-border: #2b2b2b;
        --card-accent: #9ca3af;
    }

    body.dark-mode .course-name {
        color: #e4e4e4;
    }

    body.dark-mode .course-desc {
        color: #999;
    }

    body.dark-mode .course-icon-wrap {
        background: rgba(0,0,0,0.3);
    }

    body.dark-mode .course-category-pill {
        background: rgba(0,0,0,0.3);
    }

    body.dark-mode .course-meta-item {
        background: rgba(0,0,0,0.3);
        color: white;
    }

    body.dark-mode .btn-course-primary {
        color: white;
    }

        body.dark-mode .btn-course-primary:hover {
            color: white;
        }

    body.dark-mode .btn-course-secondary {
        background: rgba(0,0,0,0.2);
        color: white;
    }

        body.dark-mode .btn-course-secondary:hover {
            background: rgba(0,0,0,0.35);
            color: white;
        }

    @@media (max-width: 600px) {
        .courses-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .courses-title {
            font-size: 1.5rem;
        }

        .course-card-actions {
            flex-direction: column;
        }
    }
</style>
