@model IEnumerable<CyberSecurityWebApp.Models.Course>

@{
    ViewData["Title"] = "Tečaji";
}

<br />

<div class="page-header">
    <h1>🎓 Tečaji kibernetske varnosti</h1>
    <p>Izboljšajte svoje znanje skozi interaktivne tečaje in praktične primere</p>
</div>

<div class="courses-grid">

    @foreach (var course in Model)
    {
        <div class="course-card">

            <div class="course-header">
                <div class="course-icon">
                    <span>@course.Icon</span>
                </div>

                <div class="course-title">
                    <h3>@course.Name</h3>
                    <span class="course-category">@course.Category</span>
                </div>
            </div>

            <div class="course-body">
                <p>@course.Description</p>

                <div class="course-meta">
                    <span>📚 5 Lekcij</span>
                    <span>📝 Kviz na koncu</span>
                </div>
            </div>

            <div class="course-actions">
                @{
                    var coursePage = "";

                    switch (course.Category)
                    {
                        case "Gesla":
                            coursePage = "/Course/Password";
                            break;

                        case "Phishing":
                            coursePage = "/Course/Phishing";
                            break;

                        case "Internet":
                            coursePage = "/Course/Internet";
                            break;

                        default:
                            coursePage = "/Course";
                            break;
                    }
                }

                <a href="@coursePage" class="btn btn-primary">
                    📖 Odpri tečaj
                </a>

                <a href="/Quiz/Start/@course.QuizId" class="btn btn-secondary">
                    🧠 Reši kviz
                </a>
            </div>

        </div>
    }

</div>