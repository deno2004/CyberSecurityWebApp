    body.dark-mode .sidebar-card {
        background: #1e1e1e;
        border-color: #2b2b2b;
        box-shadow: none;
    }

    body.dark-mode .section-header {
        border-bottom-color: #2b2b2b;
    }

    body.dark-mode .section-title,
    body.dark-mode .sidebar-step {
        color: #e4e4e4;
    }

    body.dark-mode .body-text {
