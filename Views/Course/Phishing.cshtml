    }

    body.dark-mode .phish-type-card {
        background: #252010;
        border-color: #5a4800;
    }

    body.dark-mode .phish-type-title {
        color: #e4e4e4;
    }

    body.dark-mode .phish-type-desc {
        color: #999;
    }

    body.dark-mode .phish-type-icon {
        background: rgba(230,168,23,0.15);
        color: #f5c842;
    }

    body.dark-mode .email-preview {
        border-color: #333;
    }

    body.dark-mode .email-meta {
        background: #252525;
        border-color: #333;
    }

    body.dark-mode .email-meta-label {
        color: #aaa;
    }

    body.dark-mode .email-body {
        background: #1e1e1e;
        color: #ccc;
    }

    body.dark-mode .phish-explanation {
        background: #2a2000;
        border-color: #5a4800;
        color: #f5c842;
    }

    body.dark-mode .checklist-item {
        border-color: #2b2b2b;
    }

        body.dark-mode .checklist-item:hover {
            background: #252010;
            border-color: #5a4800;
        }

    body.dark-mode .checklist-text {
        color: #bbb;
    }

    body.dark-mode .checklist-box {
        border-color: #444;
        background: #252525;
    }

    body.dark-mode .checklist-item input:checked ~ .checklist-text {
        color: #f5c842;
    }

    body.dark-mode .result-danger {
        background: #2b1c1c;
        border-color: #6b2c32;
        color: #f48898;
    }

    body.dark-mode .result-warning {
        background: #2a2000;
        border-color: #5a4800;
        color: #f5c842;
    }

    body.dark-mode .sidebar-header {
