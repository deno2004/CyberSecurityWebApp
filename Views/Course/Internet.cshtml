@model CyberSecurityWebApp.Models.Quiz
@{
    ViewData["Title"] = "Varna uporaba interneta";
}
<br />
<div class="row g-4">
    <div class="col-lg-8">

        <!-- Course Hero -->
        <div class="course-hero mb-4">
            <div class="course-hero-icon">
				<i class="bi bi-shield-lock-fill">🌐</i>
            </div>
            <div>
                <h1 class="course-title">Varna raba interneta</h1>
                <p class="course-subtitle">Naučite se varno uporabljati internet in javna omrežja</p>
            </div>
        </div>

        <!-- Section 1: 2FA -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">01</span>
                <h3 class="section-title">Dvofaktorska avtentikacija (2FA)</h3>
            </div>
            <div class="section-body">
                <p class="body-text">2FA doda <strong>dodatni sloj zaščite</strong> poleg gesla. Tudi če napadalec pozna vaše geslo, brez drugega faktorja ne bo mogel dostopiti do vašega računa.</p>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon"><i class="bi bi-phone"></i></div>
                            <div class="feature-title">SMS koda</div>
                            <div class="feature-desc">6-mestna koda po SMS sporočilu</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                            <div class="feature-title">Aplikacija (TOTP)</div>
                            <div class="feature-desc">Google / Microsoft Authenticator</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card feature-card-best">
                            <div class="feature-icon"><i class="bi bi-usb-drive"></i></div>
                            <div class="feature-title">Hardware ključ</div>
                            <div class="feature-desc">YubiKey – najmočnejša možnost</div>
                            <span class="feature-badge">Najboljše</span>
                        </div>
                    </div>
                </div>

                <div class="info-banner">
                    <i class="bi bi-lightbulb-fill"></i>
                    <div><strong>Priporočilo:</strong> Omogočite 2FA na vseh pomembnih računih — e-pošta, banka, socialna omrežja, shranjevanje v oblaku.</div>
                </div>
            </div>
        </div>

        <!-- Section 2: WiFi & VPN -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">02</span>
                <h3 class="section-title">Varno Wi-Fi omrežje &amp; VPN</h3>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="compare-card compare-bad">
                            <div class="compare-card-header">
                                <span class="compare-icon compare-icon-bad"><i class="bi bi-wifi"></i></span>
                                <span>Javno WiFi — NEVARNO</span>
                            </div>
                            <ul class="compare-list">
                                <li>Brez šifriranja prometa</li>
                                <li>Napadalci lahko prisluškujejo</li>
                                <li>"Man-in-the-middle" napadi</li>
                                <li>Lažna dostopna točka (Evil Twin)</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="compare-card compare-good">
                            <div class="compare-card-header">
                                <span class="compare-icon compare-icon-good"><i class="bi bi-shield-lock"></i></span>
                                <span>Z VPN — VARNO</span>
                            </div>
                            <ul class="compare-list">
                                <li>Šifriran promet</li>
                                <li>Skrit IP naslov</li>
                                <li>Zaščita pred prisluhovanjem</li>
                                <li>Zasebnost od ponudnika</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Tips -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">03</span>
                <h3 class="section-title">Varnostni nasveti</h3>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    @{
                        var tips = new[] {
                                        ("bi-arrow-clockwise", "success",  "#198754", "Redno posodabljanje",   "Namestite varnostne posodobitve takoj ko so na voljo."),
                                        ("bi-shield-check",    "success",  "#198754", "Protivirusna zaščita",  "Uporabite zaupanja vredne AV programe in jih posodabljajte."),
                                        ("bi-lock",            "primary",  "#0d6efd", "Zaklepanje naprav",     "Vedno zaklenite zaslon računalnika in mobilnega telefona."),
                                        ("bi-cloud-check",     "info",     "#0dcaf0", "Varnostne kopije",      "3-2-1 pravilo: 3 kopije, 2 medija, 1 zunaj lokacije."),
                                        ("bi-eye-slash",       "warning",  "#ffc107", "Zasebnost na spletu",   "Bodite previdni, kaj objavljate. Trajno je trajno."),
                                        ("bi-download",        "danger",   "#dc3545", "Prenos programov",      "Prenašajte samo iz uradnih virov. Preverite hash datotek.")
                                        };
                        foreach (var (icon, color, hex, title, text) in tips)
                        {
                            <div class="col-md-6">
                                <div class="tip-card">
                                    <div class="tip-icon" style="background: @(hex)18; color: @hex;">
                                        <i class="bi @icon"></i>
                                    </div>
                                    <div>
                                        <div class="tip-title">@title</div>
                                        <div class="tip-desc">@text</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Section 4: Habits Checklist -->
        <div class="section-card mb-4">
            <div class="section-header">
                <span class="section-badge">04</span>
                <h3 class="section-title">Moje varnostne navade</h3>
            </div>
            <div class="section-body">
                <p class="body-text">Označite navade, ki jih že izvajate:</p>

                <div id="habitsContainer" class="checklist">
                    @{
                        var habits = new[] {
                                        "Vsa gesla so dolga in edinstvena",
                                        "Uporabljam upravitelja gesel",
                                        "2FA je omogočena na e-pošti",
                                        "2FA je omogočena na banki / PayPal",
                                        "Redna varnostna kopija podatkov",
                                        "OS in programi so posodobljeni",
                                        "Protivirusni program je aktiven",
                                        "VPN uporabljam na javnem WiFi",
                                        "Redna kontrola bančnih izpiskov",
                                        "Zaklepam zaslon pri odhodu od mize",
                                        "Ne klikam na sumljive povezave",
                                        "Preverim URL pred prijavo"
                                        };
                        for (int i = 0; i < habits.Length; i++)
                        {
                            <label class="checklist-item">
                                <input type="checkbox" id="habit@i" onchange="updateHabits()">
                                <span class="checklist-box"><i class="bi bi-check"></i></span>
                                <span class="checklist-text">@habits[i]</span>
                            </label>
                        }
                    }
                </div>

                <div id="habitScore" class="mt-4"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function updateHabits() {
            const total = document.querySelectorAll('#habitsContainer input[type=checkbox]').length;
            const checked = document.querySelectorAll('#habitsContainer input[type=checkbox]:checked').length;
            const pct = Math.round(checked / total * 100);

            let color, msg;
            if (pct >= 75)      { color = '#198754'; msg = '🟢 Odlično! Ste varnostno ozaveščeni!'; }
            else if (pct >= 50) { color = '#e6a817'; msg = '🟡 Dobro – še malo napredka in ste odlični!'; }
            else if (pct >= 25) { color = '#0d6efd'; msg = '🔵 Dober začetek – nadaljujte z izboljšavami.'; }
            else                { color = '#dc3545'; msg = '🔴 Morate izboljšati varnostne navade!'; }

            document.getElementById('habitScore').innerHTML = `
                <div class="habit-score-wrap">
                    <div class="habit-score-meta">
                        <span class="habit-score-label">Varnostni rezultat</span>
                        <span class="habit-score-value" style="color:${color}">${checked}/${total} (${pct}%)</span>
                    </div>
                    <div class="habit-track">
                        <div class="habit-fill" style="width:${pct}%; background:${color};"></div>
                    </div>
                    <div class="habit-msg" style="border-color:${color}20; background:${color}10; color:${color};">${msg}</div>
                </div>`;
        }
    </script>
}

<style>
    /* ══════════════════════════════════════
           COURSE HERO
        ══════════════════════════════════════ */
    .course-hero {
        display: flex;
        align-items: center;
        gap: 20px;
        background: linear-gradient(135deg, #198754 0%, #0f5132 100%);
        border-radius: 16px;
        padding: 28px 32px;
        box-shadow: 0 8px 24px rgba(25,135,84,0.28);
    }

    .course-hero-icon {
        font-size: 2.4rem;
        color: rgba(255,255,255,0.92);
        flex-shrink: 0;
        background: rgba(255,255,255,0.16);
        width: 64px;
        height: 64px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .course-title {
        font-size: 1.65rem;
        font-weight: 800;
        color: #fff;
        margin: 0 0 4px;
        letter-spacing: -0.02em;
    }

    .course-subtitle {
        color: rgba(255,255,255,0.84);
        font-size: 0.92rem;
        margin: 0;
    }

    /* ══════════════════════════════════════
           SECTION CARDS
        ══════════════════════════════════════ */
    .section-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: box-shadow 0.2s;
    }

        .section-card:hover {
            box-shadow: 0 6px 24px rgba(0,0,0,0.09);
        }

    .section-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 28px;
        border-bottom: 1px solid #f4f4f4;
    }

    .section-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #198754;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 800;
        border-radius: 10px;
        letter-spacing: 0.04em;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .section-body {
        padding: 24px 28px;
    }

    .body-text {
        font-size: 0.93rem;
        color: #555;
        line-height: 1.65;
        margin-bottom: 14px;
    }

    /* ══════════════════════════════════════
           2FA FEATURE CARDS
        ══════════════════════════════════════ */
    .feature-card {
        position: relative;
        background: #f4fff8;
        border: 1.5px solid #b0dfc0;
        border-radius: 14px;
        padding: 20px 16px;
        text-align: center;
        transition: box-shadow 0.18s, transform 0.15s;
        height: 100%;
    }

        .feature-card:hover {
            box-shadow: 0 6px 20px rgba(25,135,84,0.15);
            transform: translateY(-2px);
        }

    .feature-card-best {
        border-color: #198754;
        background: #eafaf1;
    }

    .feature-icon {
        font-size: 2rem;
        color: #198754;
        margin-bottom: 10px;
    }

    .feature-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .feature-desc {
        font-size: 0.78rem;
        color: #666;
        line-height: 1.4;
    }

    .feature-badge {
        display: inline-block;
        background: #198754;
        color: #fff;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 99px;
        margin-top: 8px;
        letter-spacing: 0.04em;
    }

    /* ══════════════════════════════════════
           INFO BANNER
        ══════════════════════════════════════ */
    .info-banner {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #eafaf1;
        border: 1.5px solid #b0dfc0;
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 0.9rem;
        color: #0f5132;
        line-height: 1.55;
    }

        .info-banner i {
            font-size: 1.1rem;
            color: #198754;
            flex-shrink: 0;
            margin-top: 1px;
        }

    /* ══════════════════════════════════════
           COMPARE CARDS (WiFi)
        ══════════════════════════════════════ */
    .compare-card {
        border-radius: 12px;
        padding: 18px;
        height: 100%;
    }

    .compare-bad {
        background: #fff7f7;
        border: 1.5px solid #f5c0c5;
    }

    .compare-good {
        background: #f4fff8;
        border: 1.5px solid #b0dfc0;
    }

    .compare-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.88rem;
        font-weight: 700;
        margin-bottom: 14px;
    }

    .compare-bad .compare-card-header {
        color: #842029;
    }

    .compare-good .compare-card-header {
        color: #0f5132;
    }

    .compare-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .compare-icon-bad {
        background: #dc3545;
        color: #fff;
    }

    .compare-icon-good {
        background: #198754;
        color: #fff;
    }

    .compare-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.84rem;
        color: #555;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .compare-bad .compare-list li::before {
        content: "✕  ";
        color: #dc3545;
        font-weight: 700;
    }

    .compare-good .compare-list li::before {
        content: "✓  ";
        color: #198754;
        font-weight: 700;
    }

    /* ══════════════════════════════════════
           TIP CARDS
        ══════════════════════════════════════ */
    .tip-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1.5px solid #eee;
        background: #fafafa;
        transition: border-color 0.18s, box-shadow 0.18s;
        height: 100%;
    }

        .tip-card:hover {
            border-color: #ddd;
            box-shadow: 0 3px 12px rgba(0,0,0,0.07);
        }

    .tip-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .tip-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .tip-desc {
        font-size: 0.8rem;
        color: #666;
        line-height: 1.45;
    }

    /* ══════════════════════════════════════
           CHECKLIST
        ══════════════════════════════════════ */
    .checklist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 10px;
        border: 1.5px solid #eee;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
        user-select: none;
    }

        .checklist-item:hover {
            background: #f4fff8;
            border-color: #b0dfc0;
        }

        .checklist-item input {
            display: none;
        }

    .checklist-box {
        width: 22px;
        height: 22px;
        border: 2px solid #ccc;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.82rem;
        color: transparent;
        transition: all 0.18s;
        background: #fff;
    }

    .checklist-item input:checked ~ .checklist-box {
        background: #198754;
        border-color: #198754;
        color: #fff;
    }

    .checklist-item input:checked ~ .checklist-text {
        color: #0f5132;
        font-weight: 600;
    }

    .checklist-text {
        font-size: 0.85rem;
        color: #444;
        line-height: 1.35;
    }

    /* ══════════════════════════════════════
           HABIT SCORE
        ══════════════════════════════════════ */
    .habit-score-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .habit-score-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .habit-score-label {
        font-size: 0.9rem;
        font-weight: 700;
        color: #333;
    }

    .habit-score-value {
        font-size: 0.9rem;
        font-weight: 800;
    }

    .habit-track {
        height: 10px;
        background: #eee;
        border-radius: 99px;
        overflow: hidden;
    }

    .habit-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 0.4s ease, background 0.3s ease;
    }

    .habit-msg {
        padding: 12px 16px;
        border-radius: 10px;
        border: 1.5px solid;
        font-size: 0.88rem;
        font-weight: 600;
        line-height: 1.45;
    }

    /* ══════════════════════════════════════
           DARK MODE
        ══════════════════════════════════════ */
    body.dark-mode .section-card {
        background: #1e1e1e;
        border-color: #2b2b2b;
        box-shadow: none;
    }

    body.dark-mode .section-header {
        border-bottom-color: #2b2b2b;
    }

    body.dark-mode .section-title {
        color: #e4e4e4;
    }

    body.dark-mode .body-text {
        color: #aaa;
    }

    body.dark-mode .feature-card {
        background: #1c2b22;
        border-color: #2f6b48;
    }

    body.dark-mode .feature-card-best {
        background: #183825;
        border-color: #198754;
    }

    body.dark-mode .feature-title {
        color: #e4e4e4;
    }

    body.dark-mode .feature-desc {
        color: #999;
    }

    body.dark-mode .info-banner {
        background: #1a2e22;
        border-color: #2f6b48;
        color: #6ee09a;
    }

    body.dark-mode .compare-bad {
        background: #2b1c1c;
        border-color: #6b2c32;
    }

    body.dark-mode .compare-good {
        background: #1a2e22;
        border-color: #2f6b48;
    }

    body.dark-mode .compare-bad .compare-card-header {
        color: #f48898;
    }

    body.dark-mode .compare-good .compare-card-header {
        color: #6ee09a;
    }

    body.dark-mode .compare-list {
        color: #bbb;
    }

    body.dark-mode .tip-card {
        background: #252525;
        border-color: #2b2b2b;
    }

    body.dark-mode .tip-title {
        color: #e4e4e4;
    }

    body.dark-mode .tip-desc {
        color: #999;
    }

    body.dark-mode .tip-card:hover {
        border-color: #444;
    }

    body.dark-mode .checklist-item {
        border-color: #2b2b2b;
    }

        body.dark-mode .checklist-item:hover {
            background: #1a2e22;
            border-color: #2f6b48;
        }

    body.dark-mode .checklist-box {
        border-color: #444;
        background: #252525;
    }

    body.dark-mode .checklist-text {
        color: #bbb;
    }

    body.dark-mode .checklist-item input:checked ~ .checklist-text {
        color: #6ee09a;
    }

    body.dark-mode .habit-track {
        background: #333;
    }

    body.dark-mode .habit-score-label {
        color: #ccc;
    }

    @@media (max-width: 768px) {
        .checklist {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .course-hero {
            padding: 20px;
            gap: 14px;
        }

        .course-title {
            font-size: 1.3rem;
        }

        .section-body {
            padding: 18px;
        }
    }
</style>
